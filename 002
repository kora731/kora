        id="finalPaymentRow"
      >
        <span>💳 Платит</span>
        <strong id="finalPayment">—</strong>
      </div>

      <div class="plan-row">
        <span>🎬 Кино</span>
        <strong>Человек-паук — 21:50</strong>
      </div>

    </div>

    <p id="finalWaitText">
      —
    </p>

    <div class="movie-ticket">

      <div class="movie-icon">🕷️</div>

      <div class="ticket-label">
        Наше свидание
      </div>

      <div class="movie-name">
        Человек-паук
      </div>

      <div class="movie-time">
        21:50
      </div>

      <div class="ticket-date">
        24 августа 2026
        <br><br>
        До встречи, Замира ❤️
      </div>

    </div>

    <div class="signature">
      С любовью,
      <br>
      <b>Рамазан ❤️</b>
    </div>

  </section>

</main>


<script>

/* =====================================================
   ДАННЫЕ
===================================================== */

let selectedRoute = "";

let selectedFood = "";

let selectedPayment = "";

let paymentEscapeCount = 0;


/* =====================================================
   ПЕРЕКЛЮЧЕНИЕ ЭКРАНОВ
===================================================== */

function goToScreen(number) {

  document
    .querySelectorAll(".screen")
    .forEach(screen => {
      screen.classList.add("hidden");
    });

  const next =
    document.getElementById(
      "screen" + number
    );

  next.classList.remove("hidden");

  next.style.animation = "none";

  setTimeout(() => {
    next.style.animation =
      "screenAppear .5s ease";
  }, 10);

}


/* =====================================================
   СЕРДЕЧКИ ПРИ НАЖАТИИ
===================================================== */

function buttonHearts(button) {

  if (!button) return;

  const rect =
    button.getBoundingClientRect();

  const hearts = [
    "❤️",
    "💗",
    "💕",
    "💖",
    "💘",
    "💓"
  ];

  for (
    let i = 0;
    i < 14;
    i++
  ) {

    const heart =
      document.createElement("div");

    heart.className =
      "click-heart";

    heart.textContent =
      hearts[
        Math.floor(
          Math.random() *
          hearts.length
        )
      ];

    heart.style.left =
      (
        rect.left +
        rect.width / 2
      ) + "px";

    heart.style.top =
      (
        rect.top +
        rect.height / 2
      ) + "px";

    heart.style.setProperty(
      "--x",
      (
        -90 +
        Math.random() * 180
      ) + "px"
    );

    heart.style.setProperty(
      "--y",
      (
        -90 +
        Math.random() * 180
      ) + "px"
    );

    heart.style.fontSize =
      (
        14 +
        Math.random() * 18
      ) + "px";

    document.body.appendChild(heart);

    setTimeout(
      () => heart.remove(),
      1400
    );

  }

}


/* =====================================================
   ПЕРВЫЙ ЭКРАН
===================================================== */

function startInvitation(button) {

  buttonHearts(button);

  setTimeout(
    () => goToScreen(2),
    250
  );

}


/* =====================================================
   КНОПКА "НЕТ"
===================================================== */

const noBtn =
  document.getElementById("noBtn");

function moveNoButton() {

  const padding = 15;

  const width =
    noBtn.offsetWidth || 120;

  const height =
    noBtn.offsetHeight || 50;

  const maxX =
    Math.max(
      padding,
      window.innerWidth -
      width -
      padding
    );

  const maxY =
    Math.max(
      padding,
      window.innerHeight -
      height -
      padding
    );

  const x =
    padding +
    Math.random() *
    Math.max(
      10,
      maxX - padding
    );

  const y =
    padding +
    Math.random() *
    Math.max(
      10,
      maxY - padding
    );

  noBtn.style.position =
    "fixed";

  noBtn.style.left =
    x + "px";

  noBtn.style.top =
    y + "px";

  noBtn.style.zIndex =
    "9999";

  buttonHearts(noBtn);

}


/* Компьютер */

noBtn.addEventListener(
  "mouseenter",
  moveNoButton
);


/* Телефон */

noBtn.addEventListener(
  "touchstart",
  function(event) {

    event.preventDefault();

    moveNoButton();

  },
  {
    passive: false
  }
);


/* Клик */

noBtn.addEventListener(
  "click",
  function(event) {

    event.preventDefault();

    moveNoButton();

  }
);


/* =====================================================
   ПРОГУЛКА
===================================================== */

function chooseWalk(button) {

  selectedRoute =
    "Погулять";

  buttonHearts(button);

  setTimeout(
    () => goToScreen(3),
    250
  );

}

function confirmWalk(button) {

  selectedChoice = "Парк аттракционов 🎢";

  selectedPayment =
    "Рамазан ❤️";

  buttonHearts(button);

  setTimeout(
    () => goToScreen(6),
    300
  );

}


/* =====================================================
   ЕДА
===================================================== */

function chooseFood(button) {

  selectedRoute =
    "Покушать";

  buttonHearts(button);

  setTimeout(
    () => goToScreen(4),
    250
  );

}


function chooseFoodItem(
  food,
  button
) {

  selectedFood = food;

  document.getElementById(
    "foodSelected"
  ).textContent =
    food;

  buttonHearts(button);

  setTimeout(
    () => goToScreen(5),
    300
  );

}


/* =====================================================
   КНОПКА РАМАЗАН
   УБЕГАЕТ ДВА РАЗА,
   НА ТРЕТИЙ ПОЗВОЛЯЕТ ВЫБРАТЬ
===================================================== */

const ramazanBtn =
  document.getElementById(
    "ramazanBtn"
  );


function moveRamazanButton() {

  paymentEscapeCount++;

  buttonHearts(
    ramazanBtn
  );

  if (
    paymentEscapeCount >= 3
  ) {

    ramazanBtn.style.position =
      "relative";

    ramazanBtn.style.left =
      "";

    ramazanBtn.style.top =
      "";

    ramazanBtn.textContent =
      "💳 Рамазан ❤️";

    document.getElementById(
      "paymentHint"
    ).textContent =
      "Ну всё, поймала 😌";

    return;

  }

  const padding = 15;

  const width =
    ramazanBtn.offsetWidth ||
    170;

  const height =
    ramazanBtn.offsetHeight ||
    55;

  const maxX =
    Math.max(
      padding,
      window.innerWidth -
      width -
      padding
    );

  const maxY =
    Math.max(
      padding,
      window.innerHeight -
      height -
      padding
    );

  ramazanBtn.style.position =
    "fixed";

  ramazanBtn.style.left =
    (
      padding +
      Math.random() *
      Math.max(
        10,
        maxX - padding
      )
    ) + "px";

  ramazanBtn.style.top =
    (
      padding +
      Math.random() *
      Math.max(
        10,
        maxY - padding
      )
    ) + "px";

  ramazanBtn.style.zIndex =
    "9999";


  if (
    paymentEscapeCount === 1
  ) {

    document.getElementById(
      "paymentHint"
    ).textContent =
      "Ой... кнопка решила убежать 😂";

  } else {

    document.getElementById(
      "paymentHint"
    ).textContent =
      "Она снова убежала 😭";
  }

}


/* Наведение */

ramazanBtn.addEventListener(
  "mouseenter",
  function() {

    if (
      paymentEscapeCount < 3
    ) {

      moveRamazanButton();

    }

  }
);


/* Телефон */

ramazanBtn.addEventListener(
  "touchstart",
  function(event) {

    if (
      paymentEscapeCount < 3
    ) {

      event.preventDefault();

      moveRamazanButton();

    }

  },
  {
    passive: false
  }
);


/* Клик */

ramazanBtn.addEventListener(
  "click",
  function(event) {

    if (
      paymentEscapeCount < 2
    ) {

      event.preventDefault();

      moveRamazanButton();

      return;
    }

    if (
      paymentEscapeCount === 2
    ) {

      event.preventDefault();

      moveRamazanButton();

      return;
    }

    selectedPayment =
      "Рамазан ❤️";

    buttonHearts(
      ramazanBtn
    );

    document.getElementById(
      "paymentHint"
    ).textContent =
      "Сегодня я угощаю 😌❤️";

    setTimeout(
      () => goToScreen(6),
      300
    );

  }
);


/* =====================================================
   ОПЛАТА — ЗАМИРА
===================================================== */

function payByZamira(button) {

  selectedPayment =
    "Замира 👑";

  buttonHearts(button);

  document.getElementById(
    "paymentHint"
  ).textContent =
    "Ого! Вот это поворот 😂";

  setTimeout(
    () => goToScreen(6),
    350
  );

}


/* =====================================================
   ПОЛЗУНОК
===================================================== */

const waitSlider =
  document.getElementById(
    "waitSlider"
  );

const waitPercent =
  document.getElementById(
    "waitPercent"
  );

const sliderFill =
  document.getElementById(
    "sliderFill"
  );


function updateWaitSlider() {

  const value =
    Number(
      waitSlider.value
    );

  waitPercent.textContent =
    value + "%";

  sliderFill.style.width =
    value + "%";

}


waitSlider.addEventListener(
  "input",
  updateWaitSlider
);

updateWaitSlider();


/* =====================================================
   ФИНАЛЬНЫЙ ВОПРОС
===================================================== */

function finishInvitation(
  button
) {

  const value =
    Number(
      waitSlider.value
    );

  buttonHearts(button);

  let finalText = "";
  let waitText = "";

  if (
    value >= 90
  ) {

    finalText =
      `${value}%?! 😳❤️
      <br><br>
      Вот это мне нравится!
      <br>
      Теперь я точно буду
      ждать 24 августа
      ещё сильнее тебя 😌`;

    waitText =
      "Кажется, теперь я буду ждать нашу встречу ещё сильнее тебя 😏❤️";

  } else if (
    value >= 60
  ) {

    finalText =
      `${value}% — уже неплохо 😌❤️
      <br><br>
      Но почему мне кажется,
      что ты немного занизила? 😏`;

    waitText =
      "24 августа проверим, насколько честным был этот процент 😏";

  } else if (
    value >= 30
  ) {

    finalText =
      `${value}%? 😏
      <br><br>
      Ладно...
      тогда постараюсь сделать
      наше свидание таким,
      чтобы стало 100% ❤️`;

    waitText =
      "У меня есть время, чтобы изменить этот процент 😌❤️";

  } else {

    finalText =
      `${value}%?! 😂
      <br><br>
      Кажется, нам придётся
      срочно исправлять ситуацию
      24 августа ❤️`;

    waitText =
      "Хорошо... тогда удивлю тебя 😏";
  }


  /* Если прогулка */

  if (
    selectedRoute ===
    "Погулять"
  ) {

    selectedChoice =
      "Парк аттракционов 🎢";

    document.getElementById(
      "finalMeetTime"
    ).textContent =
      "20:00";

    document.getElementById(
      "finalChoice"
    ).textContent =
      "Парк аттракционов 🎢";

    document.getElementById(
      "finalPayment"
    ).textContent =
      "Рамазан ❤️";

  }

  /* Если еда */

  else {

    document.getElementById(
      "finalMeetTime"
    ).textContent =
      "21:00";

    document.getElementById(
      "finalChoice"
    ).textContent =
      selectedFood;

    document.getElementById(
      "finalPayment"
    ).textContent =
      selectedPayment;

  }


  document.getElementById(
    "finalMessage"
  ).innerHTML =
    finalText;

  document.getElementById(
    "finalWaitText"
  ).textContent =
    waitText;


  goToScreen(7);

  createHeartBurst();

  createConfetti();

}


/* =====================================================
   ПАДАЮЩИЕ СЕРДЦА
===================================================== */

function createFallingHeart() {

  const heart =
    document.createElement("div");

  heart.className =
    "falling-heart";

  const hearts = [
    "❤️",
    "💗",
    "💕",
    "💖",
    "💘",
    "💓"
  ];

  heart.textContent =
    hearts[
      Math.floor(
        Math.random() *
        hearts.length
      )
    ];

  heart.style.left =
    Math.random() *
    100 +
    "vw";

  heart.style.fontSize =
    18 +
    Math.random() *
    25 +
    "px";

  heart.style.animationDuration =
    3 +
    Math.random() *
    4 +
    "s";

  document.body.appendChild(
    heart
  );

  setTimeout(
    () => heart.remove(),
    8000
  );

}


/* Постоянный фон */

setInterval(
  createFallingHeart,
  800
);


/* =====================================================
   ВСПЛЕСК СЕРДЕЦ
===================================================== */

function createHeartBurst() {

  for (
    let i = 0;
    i < 45;
    i++
  ) {

    setTimeout(
      createFallingHeart,
      i * 45
    );

  }

}


/* =====================================================
   КОНФЕТТИ
===================================================== */

function createConfetti() {

  const symbols = [
    "♥",
    "◆",
    "●",
    "★"
  ];

  for (
    let i = 0;
    i < 85;
    i++
  ) {

    setTimeout(() => {

      const piece =
        document.createElement(
          "div"
        );

      piece.className =
        "confetti";

      piece.textContent =
        symbols[
          Math.floor(
            Math.random() *
            symbols.length
          )
        ];

      piece.style.left =
        Math.random() *
        100 +
        "vw";

      piece.style.fontSize =
        8 +
        Math.random() *
        10 +
        "px";

      piece.style.opacity =
        .5 +
        Math.random() *
        .5;

      piece.style.animationDuration =
        2 +
        Math.random() *
        3 +
        "s";

      piece.style.color =
        `hsl(
          ${330 + Math.random() * 40},
          100%,
          ${65 + Math.random() * 20}%
        )`;

      document.body.appendChild(
        piece
      );

      setTimeout(
        () => piece.remove(),
        6000
      );

    }, i * 18);

  }

}


/* =====================================================
   ДАННЫЕ ПО УМОЛЧАНИЮ
===================================================== */

let selectedChoice = "";
</script>


</body>

</html>
